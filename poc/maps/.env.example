# Google Maps JavaScript API 브라우저 키 (선택 — 없으면 OSM 모드만 사용)
VITE_GOOGLE_MAPS_API_KEY=

# 백엔드 resolve 프록시 base URL (선택, trailing slash 없음)
# 설정 시 short/list 링크는 POST /api/maps/resolve-link · resolve-list-link 우선 호출.
# GitHub Pages: repo secret VITE_RESOLVE_API_BASE → Actions 빌드에 주입 (소스에 URL 하드코딩 금지).
VITE_RESOLVE_API_BASE=
